# Predložak konfiguracije. Kopiraj u .env i po potrebi prilagodi:
#   Linux/macOS:  cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env
# .env nikad ne ide u git repozitorij jer sadrži tajne.

ENV=dev

# postgresql+asyncpg:// označava asinkroni driver za PostgreSQL
DATABASE_URL=postgresql+asyncpg://padel_user:padel_pass@localhost:5432/padel_hub

# Samo za lokalni razvoj. U produkciji generirati npr. pomoću: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_ISSUER=padel-hub
